<Window
    x:Class="DPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DPlayer.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!--
      根背景必须是 Transparent，Mica 才看得见（fix round 1 实测推翻上一轮"Mica 未挂载"的结论）：
      同一组采样点（标题栏 / 导航栏 / 内容区 / 播放器栏）在三种形态下的像素——
        1) SystemBackdrop=MicaBackdrop + 不透明页面底色（上一轮提交形态）：#202020 / #272727，
           换窗口位置**不变** —— 材质被这层不透明刷整片盖住；
        2) SystemBackdrop=MicaBackdrop + 本 Grid Transparent：#1E2024 / #232733，
           换到另一块桌布位置变成 #1C2027 / #1A212C —— 随窗外内容变化 = 活的材质；
        3) 不挂任何 backdrop + Transparent（对照组）：#000000 / #111111，换位置不变 —— 没有材质层。
      手动 Microsoft.UI.Composition.SystemBackdrops.MicaController + SystemBackdropConfiguration
      （AddSystemBackdropTarget(window as ICompositionSupportsSystemBackdrop) 不抛、
      SetSystemBackdropConfiguration 返回、IsSupported=True、State=Fallback）产出的像素与 2) 完全一致，
      所以保留更简单的框架属性路线，手动控制器已删除。
      注：DWMWA_SYSTEMBACKDROP_TYPE 三条都读回 0 —— WinUI 的 backdrop 由组合器挂载，
      该 DWM 属性不是判据，上一轮就是被它误导的。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（第一行交给系统拖拽区） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <TextBlock x:Name="AppTitle" Text="D-player" Margin="16,0,0,0"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <muxc:NavigationView Grid.Row="1" x:Name="Nav"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             SelectionChanged="Nav_SelectionChanged">
            <Grid>
                <!--
                  ItemsSource 走代码后置赋值（ResyncView 里），不用 x:Bind：
                  brief 给的 {x:Bind ViewModel.ViewedPlaylist.Queue, Mode=OneWay} 会让 XamlCompiler
                  在 MarkupCompilePass1 里抛 WMC9999（可空中间段 ViewedPlaylist 是普通 INPC 属性，
                  不是依赖属性，编译器内部崩溃且连错误消息都本地化失败）。见 Task 4 报告。
                -->
                <ListView x:Name="TrackList" DoubleTapped="TrackList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid ColumnSpacing="12" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Artist}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态：切片期没有导入入口（第二阶段接 picker），首启就是这个样子 -->
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="6" IsHitTestVisible="False">
                    <TextBlock Text="当前歌单没有曲目" HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="本切片不提供导入入口：把曲目写进 %LocalAppData%\D-player-winui\queue.json 后重启。"
                               HorizontalAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </muxc:NavigationView>

        <!-- 播放器栏 -->
        <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Click="PlayPause_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="播放/暂停">
                <FontIcon Glyph="{x:Bind PlayPauseGlyph, Mode=OneWay}" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind NowPlayingText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1"
                        Value="{x:Bind PositionFraction, Mode=OneWay}"
                        ValueChanged="Position_Changed"
                        AutomationProperties.Name="播放进度" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Text="{x:Bind TimeText, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
