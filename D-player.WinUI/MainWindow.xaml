<Window
    x:Class="DPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      根背景必须是 Transparent，Mica 才看得见（fix round 1 实测推翻上一轮"Mica 未挂载"的结论）：
      同一组采样点（标题栏 / 导航栏 / 内容区 / 播放器栏）在三种形态下的像素——
        1) SystemBackdrop=MicaBackdrop + 不透明页面底色（上一轮提交形态）：#202020 / #272727，
           换窗口位置**不变** —— 材质被这层不透明刷整片盖住；
        2) SystemBackdrop=MicaBackdrop + 本 Grid Transparent：#1E2024 / #232733，
           换到另一块桌布位置变成 #1C2027 / #1A212C —— 随窗外内容变化 = 活的材质；
        3) 不挂任何 backdrop + Transparent（对照组）：#000000 / #111111，换位置不变 —— 没有材质层。
      手动 Microsoft.UI.Composition.SystemBackdrops.MicaController + SystemBackdropConfiguration
      （AddSystemBackdropTarget(window as ICompositionSupportsSystemBackdrop) 不抛、
      SetSystemBackdropConfiguration 返回、IsSupported=True、State=Fallback）产出的像素与 2) 完全一致，
      所以保留更简单的框架属性路线，手动控制器已删除。
      注：DWMWA_SYSTEMBACKDROP_TYPE 三条都读回 0 —— WinUI 的 backdrop 由组合器挂载，
      该 DWM 属性不是判据，上一轮就是被它误导的。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（第一行交给系统拖拽区）；高度取 Tokens.xaml 的 TitleBarHeight -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="{StaticResource TitleBarHeight}">
            <TextBlock x:Name="AppTitle" Text="D-player" Margin="16,0,0,0"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />

            <!--
              右栏（信息面板）的折叠钮住在标题栏右端，**不在 InfoPanel 里**。理由：brief Step 3 把右栏的
              折叠终值钉成 260 <-> **0**，面板收成 0 宽之后它自己那颗钮也跟着点不到，A3 的"折叠钮各两次"
              就只剩单向；而折叠状态**不许持久化**（要往 settings.json 加字段就动了 Core，本阶段明确不做），
              所以必须留一个与宽度无关的常驻入口。位置取 Tokens 的 InfoPanelToggleMargin：右端让开系统
              Caption Buttons（3 x 46 = 138，本机 scale=1.0 实测量到），正好落在右栏的正上方。
              左栏那颗钮仍在栏内（折叠态 48px 仍看得见、点得到），见 Views/NavRail.xaml。
            -->
            <Button x:Name="InfoPanelToggle" Width="{StaticResource FoldButtonSize}" Height="{StaticResource FoldButtonSize}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="{StaticResource InfoPanelToggleMargin}"
                    Style="{StaticResource IconButtonStyle}"
                    Click="InfoPanelToggle_Click"
                    AutomationProperties.Name="收起或展开信息栏" ToolTipService.ToolTip="收起或展开信息栏">
                <FontIcon x:Name="InfoPanelToggleGlyph" Glyph="&#xE76C;" FontSize="{StaticResource FontSizeCaption}" />
            </Button>
        </Grid>

        <!--
          三栏槽位（左导航 / 中列表 / 右信息），列宽由控件自己的宽度（Tokens 的 NavRailWidth / InfoPanelWidth）
          决定 —— 三列都是 Auto/*，所以栏宽一变小中列就跟着变宽（A2 的"中列表变宽"）。
          底栏由代码加进 RootGrid 的第 2 行。

          四个控件为什么在代码里装配而不是写在这里：XAML 里声明元素要求 public 无参构造，而计划钉住的
          构造签名是 NavRail(PlaylistsViewModel) / TrackList(PlaylistsViewModel) / InfoPanel(PlayerViewModel) /
          PlayerBar(PlayerViewModel)（spec §3.1：每个控件自己持有它那一块的绑定源），
          并且 x:Bind 的源必须在 InitializeComponent() 之前就位（见 PlayerBar.xaml.cs 构造函数注释）。
        -->
        <Grid x:Name="BodyGrid" Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>
