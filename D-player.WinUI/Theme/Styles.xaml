<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      列表项容器（NavRail 与 TrackList 的 ListView 共用，两个视图都通过 ItemContainerStyle 引用本样式
      或它的 BasedOn 派生）。NavRail 在本地 RailItemStyle 里只补 Padding；TrackList 在 TrackList.xaml
      里直接引用本样式（Task 3 落地）。

      ── 状态名是量出来的，不是猜的（2026-10-07）──
      组名与状态名都由控件按**名字**驱动，写错不报错、只会让该状态静默不生效。因此下面的名字逐字抄自
      Windows App SDK 自带的 Themes/generic.xaml（本机解析到的包：
      ~/.nuget/packages/microsoft.windowsappsdk.winui/2.3.9/lib/net6.0-windows10.0.17763.0/
      Microsoft.WinUI/Themes/generic.xaml；lib/native/Microsoft.UI/Themes/generic.xaml 与之 md5 相同），
      取自 TargetType="ListViewItem" 的三套当代模板 ListViewItemRevealStyle / ListViewItemExpanded /
      RadioButtonsItemStyle。抄到的原始名字清单：
        · CommonStates    -> Normal / PointerOver / Pressed / Selected / PointerOverSelected /
                             PressedSelected            （Reveal 版另有 PointerOverPressed）
        · DisabledStates  -> Enabled / Disabled
      与计划稿占位的三处差异（计划稿已声明"以 generic.xaml 为准"）：
        1) **没有 SelectionStates 这个组**：ListViewItem 的选中态就在 CommonStates 里，
           和指针态合成一个名字；generic.xaml 里的 SelectionStates 属于
           ListPickerFlyoutPresenterItemStyle / CalendarDatePicker / PivotHeaderItem，不是本控件。
        2) SelectedPointerOver → **PointerOverSelected**，SelectedPressed → **PressedSelected**
           （顺序相反；SelectedPointerOver 在 generic.xaml 里只出现在 ComboBoxItem / ItemContainer /
           SelectorBarItem / PivotHeaderItem 的模板里）。
        3) Disabled **不在 CommonStates**，它在独立的 DisabledStates 组里，与 Enabled 成对。
      左侧强调条在选中系状态从 0 长到 3px（Opacity 0→1）。
    -->
    <Style x:Key="RailListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource RowHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="ItemRoot" Background="{TemplateBinding Background}"
                          Control.IsTemplateFocusTarget="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- ② 选中强调条：Width 由 0 动画到 3（100ms，MotionTokens.Fast） -->
                        <Rectangle x:Name="SelectionBar" Width="0"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <!-- ① 悬停/选中背景过渡层：Opacity 走 150ms DoubleAnimation 而非瞬变 Setter -->
                        <Rectangle x:Name="HoverOverlay" Grid.ColumnSpan="2"
                                   Fill="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Rectangle x:Name="SelectedOverlay" Grid.ColumnSpan="2"
                                   Fill="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter" Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverPressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="Width"
                                                         To="3" Duration="0:0:0.100"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="Width"
                                                         To="3" Duration="0:0:0.100"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.150"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="Width"
                                                         To="3" Duration="0:0:0.100"
                                                         EasingFunction="{StaticResource StandardEasing}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      折叠钮样式（左右两颗折叠钮共用）：透明底、悬停 SubtleFillColorSecondaryBrush、按下 tertiary。
      六态：Normal(透明) / PointerOver(secondary) / Pressed(tertiary) / Disabled(0.4 不透明)。
      边框默认 0，Padding 0 —— 几何由钮的 Width/Height（FoldButtonSize）与 FontIcon 的字号决定。
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Root"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      CornerRadius="{ThemeResource ControlCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      播放/暂停钮（44px 圆钮）。六态：Normal / PointerOver(SubtleFillColorSecondary) /
      Pressed(SubtleFillColorTertiary) / Disabled(Opacity 0.4)。
      圆角 = 半径 22 = PlayButtonSize/2（Tokens.xaml 提供 PlayButtonSize）。
      UseSystemFocusVisuals=True 让 Tab 聚焦时出现 2px 焦点环（B4）。
    -->
    <Style x:Key="PlayPauseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource PlayButtonSize}" />
        <Setter Property="Height" Value="{StaticResource PlayButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Root"
                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      CornerRadius="22">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      进度滑块样式。默认 Slider 模板已含完整六态（Normal/PointerOver/Pressed/Disabled 等），
      本样式只补 UseSystemFocusVisuals 确保 Tab 聚焦时出现 2px 焦点环（B4）。
    -->
    <Style x:Key="ProgressSliderStyle" TargetType="Slider">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!--
      表头行：静态 Grid，不可点击——表头不可点是有意的，排序属功能阶段（spec §5）。
      列宽与 TrackList 行模板同步（注释标出"与表头同步"），样式名仅作命名标记。
    -->

    <!--
      列表滚动条样式。WinUI 默认 ScrollViewer/ScrollBar 已提供"细窄、悬停加宽"行为
      （ScrollView 的默认 VisualState 里 HorizontalScrollBarIndicator 在 PointerOver 时加粗），
      本样式仅确认此行为存在，不额外覆盖。B1 的 hover 反馈由 RailListViewItemStyle 提供。
    -->
    <Style x:Key="RailScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
