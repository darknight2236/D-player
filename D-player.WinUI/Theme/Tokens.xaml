<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 间距（只用 4 的倍数，实际取值 4/8/12/16/24） -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>

    <!-- 圆角：控件 4 / 列表项与卡片 8 / 面板 12 -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusItem">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>

    <!-- 字号：Caption 12 / Body 13.5 / Subtitle 15 / Title 20 -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">13.5</x:Double>
    <x:Double x:Key="FontSizeSubtitle">15</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>

    <!-- 结构尺寸（三栏与底栏；改动集中在这里） -->
    <x:Double x:Key="NavRailWidth">200</x:Double>
    <x:Double x:Key="NavRailCollapsedWidth">48</x:Double>
    <x:Double x:Key="InfoPanelWidth">260</x:Double>
    <x:Double x:Key="PlayerBarHeight">64</x:Double>
    <x:Double x:Key="TitleBarHeight">32</x:Double>
    <x:Double x:Key="RowHeight">36</x:Double>
    <!-- 自动收起阈值（spec §10：起始值，集中在此便于调） -->
    <x:Double x:Key="InfoPanelAutoCollapseWidth">960</x:Double>
    <!-- 迟滞带（spec §8「阈值变化需带 8px 迟滞」）：越过 threshold 才收、要越回 threshold+8 才放，
         不然在阈值上拖 1px 就反复收放（A2 的"抽搐抖动"失败态）。brief 把它写成 C# const，
         按"尺寸集中在 Tokens"的硬约束挪到这里，MainWindow 用 TokenResource 读。 -->
    <x:Double x:Key="AutoCollapseHysteresis">8</x:Double>

    <!--
      Task 2（三栏与折叠）追加。都是"尺寸"，按硬约束不许散在 XAML 里写字面量，所以一并入 Tokens：
        · RailBadgeSize 24 —— 左栏每行的歌单首字徽标。折叠态 48px 时正好居中：
          RailListViewItemStyle 那条 12px 的左右 Padding 决定徽标左缘在 12，12 + 24/2 = 24 = 48/2。
        · InfoPanelCoverSize 228 —— 右栏封面正方形。= InfoPanelWidth 260 - 两侧 PanelPadding 16（spec §5 正方形）。
          同一个值也当 CoverArtLoader 的解码边长（按目标尺寸解码，spec §8「封面大图导致切歌卡顿」的缓解项）。
        · FoldButtonSize 24 —— 两个折叠钮的直径（左栏表头钮 / 标题栏右栏钮）。左栏那个同样取 24，
          与 RailBadgeSize 同值，才能在 48px 折叠态里和徽标一样居中。
    -->
    <x:Double x:Key="RailBadgeSize">24</x:Double>
    <x:Double x:Key="InfoPanelCoverSize">228</x:Double>
    <x:Double x:Key="FoldButtonSize">24</x:Double>
    <!-- 无封面时的音符字号（spec §5 占位封面；排版细则归 Task 3，这里先给一个不散落的值） -->
    <x:Double x:Key="CoverGlyphSize">48</x:Double>
    <!--
      Padding 是 Thickness 而不是 double：StaticResource 不做标记类型转换（TypeConverter 只作用于标记里的
      **字符串**值），所以 `{Padding="{StaticResource SpacingLg}"}`（x:Double）会在加载期抛类型不符。
      这里直接存 Thickness 令牌；顺序仍须在 Styles.xaml 之前合并（App.xaml 的承重注释）。
      RailItemPadding 的 12 是拆分前逐条 `ListViewItem.Padding` 的量，改成容器样式 Setter 后仍要成立
      （3px 强调条贴行最左 + 折叠态徽标居中）。
    -->
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="RailItemPadding">12,0,12,0</Thickness>
    <Thickness x:Key="RailHeaderPadding">12,8,12,0</Thickness>
    <!-- 标题栏右端给系统 Caption Buttons（3 x 46px）让位：右栏折叠钮的右边距，本机 scale=1.0 实测 138 -->
    <Thickness x:Key="InfoPanelToggleMargin">0,0,138,0</Thickness>
</ResourceDictionary>
