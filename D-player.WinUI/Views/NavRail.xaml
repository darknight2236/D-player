<UserControl
    x:Class="DPlayer.WinUI.Views.NavRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DPlayer.ViewModels"
    xmlns:views="using:DPlayer.WinUI.Views">

    <!--
      左导航栏（spec §5：默认 200px、折叠 48px）。宽度取 Tokens.xaml 的 NavRailWidth / NavRailCollapsedWidth。
      根不写背景刷：Mica 是挂在窗口上的材质，只有**没有不透明背景刷**的表面后面才看得见
      （实测见 MainWindow.xaml 顶部注释），InfoPanel/TrackList 同理。

      Task 2（本文件）改成了声明式：`ItemsSource` 绑本控件自己的 `Playlists.Playlists`，
      `SelectedItem` 双向绑 `Playlists.ViewedPlaylist`（唯一真源，与 WPF 侧栏同纪律），
      条目内容走 `DataTemplate`（徽标＝歌单名首字 + 名称），不再手工增删条目、不再每次点击整栏重建。
      只绑一层（`Playlists.Playlists` / `Playlists.ViewedPlaylist`），不写跨层链（XamlCompiler WMC9999，
      见 TrackList.xaml 的注释）。折叠钮与文字淡出见 NavRail.xaml.cs。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 徽标＝名称首字；空名回落成「?」（Substring 越界会在渲染期抛，见 PlaylistInitialConverter） -->
            <views:PlaylistInitialConverter x:Key="PlaylistInitial" />

            <!--
              左栏行容器：在 Theme/Styles.xaml 的 RailListViewItemStyle 之上只补一条 Padding。
              拆分前这是逐条 `new ListViewItem { Padding = 12,0,12,0 }` 设的（为了让 3px 强调条仍贴在行最左、
              文字不贴边）；声明式之后条目由 ListView 生成，只能挂在容器样式上。
              这个 12 还顺带把折叠态（48px）的徽标摆正：12 + 徽标 24/2 = 24 = 48/2。
              跨字典 StaticResource 只能向上找**已合并在前**的字典，RailListViewItemStyle 在 App 级 Styles.xaml 里，
              合并顺序（Tokens → Styles）见 App.xaml 的承重注释。
            -->
            <Style x:Key="RailItemStyle" TargetType="ListViewItem"
                   BasedOn="{StaticResource RailListViewItemStyle}">
                <Setter Property="Padding" Value="{StaticResource RailItemPadding}" />
            </Style>

            <!--
              Tag="Fade" 是「折叠时要先淡出的文字」哨兵：代码里按 Tag 收集（WinUI 3 不支持
              RelativeSource FindAncestor，ElementName 又出不了 DataTemplate 的 namescope，
              实测依据见 task-2-report.md §0.1），再用 Storyboard.SetTarget 逐个挂 —— SetTarget
              走的是运行时元素引用，不需要 namescope。徽标不淡出：折叠态只留图标（spec §5）。
            -->
            <DataTemplate x:Key="RailItemTemplate" x:DataType="vm:PlaylistViewModel">
                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="{StaticResource RailBadgeSize}" Height="{StaticResource RailBadgeSize}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind Name, Converter={StaticResource PlaylistInitial}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Tag="Fade"
                               FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Rail" Width="{StaticResource NavRailWidth}" RowSpacing="{StaticResource SpacingSm}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：折叠钮（24x24，折叠态 48px 时正好居中）+「歌单」小标题（Caption 12，spec §5） -->
        <Grid Grid.Row="0" Padding="{StaticResource RailHeaderPadding}"
              ColumnSpacing="{StaticResource SpacingSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="FoldButton" Width="{StaticResource FoldButtonSize}" Height="{StaticResource FoldButtonSize}"
                    Padding="0" BorderThickness="0" VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    Click="FoldButton_Click"
                    AutomationProperties.Name="折叠或展开歌单栏" ToolTipService.ToolTip="折叠或展开歌单栏">
                <FontIcon x:Name="FoldButtonGlyph" Glyph="&#xE76B;" FontSize="{StaticResource FontSizeCaption}" />
            </Button>
            <TextBlock x:Name="HeaderLabel" Grid.Column="1" Text="歌单" Tag="Fade"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--
          声明式条目源（brief Step 1 的形状）+ ItemContainerStyle 用上面的 RailItemStyle（MinHeight=36 来自基样式）。
          SelectedItem 这里是 **OneWay** 而不是 brief 写的 TwoWay：TwoWay 会在集合变化把选中项挤出去时
          把 null 写回 ViewedPlaylist，理由与代码在 NavRail.xaml.cs 的 PlaylistList_SelectionChanged 注释里。
          回写走 SelectionChanged，语义与 TwoWay 在"用户选了一行"这条路径上等价，只是 null 不回流。
        -->
        <ListView x:Name="PlaylistList" Grid.Row="1"
                  ItemsSource="{x:Bind Playlists.Playlists, Mode=OneWay}"
                  SelectedItem="{x:Bind Playlists.ViewedPlaylist, Mode=OneWay}"
                  SelectionChanged="PlaylistList_SelectionChanged"
                  ItemTemplate="{StaticResource RailItemTemplate}"
                  ItemContainerStyle="{StaticResource RailItemStyle}"
                  SelectionMode="Single"
                  AutomationProperties.Name="歌单" />
    </Grid>
</UserControl>
