<UserControl
    x:Class="DPlayer.WinUI.Views.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      播放器栏（底栏）。高度由 Tokens 的 PlayerBarHeight 钉死（spec §5：64px）。
      垂直内边距 6+6 留出 52px 内容区，刚好容纳 19px 文本行 + 32px 滑块（合计 51px）不裁切；
      旧的 16,8（8+8 只留 48 < 51）是 Phase 21 验收 A1 FAIL 的根因——栏高被内容撑到 67px。
    -->
    <Grid Height="{StaticResource PlayerBarHeight}"
          Padding="16,6" ColumnSpacing="12"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PlayPauseButton" Click="PlayPause_Click"
                Style="{StaticResource PlayPauseButtonStyle}"
                IsEnabled="{x:Bind HasPlayableSource, Mode=OneWay}"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                PointerEntered="PlayPauseButton_PointerEntered"
                PointerExited="PlayPauseButton_PointerExited"
                PointerPressed="PlayPauseButton_PointerPressed"
                PointerReleased="PlayPauseButton_PointerReleased"
                AutomationProperties.Name="播放/暂停">
            <Button.RenderTransform>
                <ScaleTransform x:Name="PlayPauseScale" ScaleX="1" ScaleY="1" />
            </Button.RenderTransform>
            <!-- ⑦ 两个 FontIcon 叠放，交叉淡入 100ms（不旋转） -->
            <Grid>
                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="1" />
                <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0" />
            </Grid>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind NowPlayingText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <!--
              进度条的两条用户输入路径都挂在模板部件上，**在代码后置里订阅**（PlayerBar.xaml.cs 的
              HookSliderParts），而不是在 markup 里：WinUI 的 XamlCompiler 不认 markup 写法
              —— `DragStarted="…"` 报 WMC0011 "Unknown member"，`prim:Thumb.DragStarted="…"`
              报 WMC0010 "Unknown attachable member"（两者都在本壳上实测过，2026-10-07）。
              · 拖动 → 模板 Thumb（HorizontalThumb）的 DragStarted / DragCompleted。
              · 单击定位 → 模板轨道（HorizontalTemplate）的 PointerPressed，见 Position_TrackPressed。
              StepFrequency 必须显式给：默认值 1 配上默认 SnapsTo=StepValues（枚举里没有 None，
              量化关不掉）在 0..1 的量程上把整条轨道量化成 {0,1} 两个落点 —— 2026-10-07 实测量出的
              缺陷根因。0.001 = 千分之一程，比一个像素还细（本机轨道 904 px / 滑块 18 px →
              一格约 0.9 px）。单击在轨道挂上时不依赖它（轨道上的按下被我们自己吃掉了，落点由
              TryGetTrackFraction 算）；万一轨道找不到、退回控件自己那条 move-to-point，
              落点精度就是靠它兜着的（实测 0.248 / 0.499 / 0.749，仍是点上而不是端点）。
              拖动这一半则始终靠它。
              Value 绑的是 Core 的 `PlayerViewModel.PositionNormalized`（壳侧不抄第二份公式，见 A4）。
            -->
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" StepFrequency="0.001"
                    SmallChange="0.005" LargeChange="0.05"
                    Style="{StaticResource ProgressSliderStyle}"
                    IsEnabled="{x:Bind HasDuration, Mode=OneWay}"
                    Value="{x:Bind Player.PositionNormalized, Mode=OneWay}"
                    ValueChanged="Position_Changed"
                    AutomationProperties.Name="播放进度"
                    AutomationProperties.HelpText="方向键微调约 0.5%，PageUp/PageDown 约 5%" />
        </StackPanel>
        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                   Text="{x:Bind TimeText, Mode=OneWay}" />
    </Grid>
</UserControl>
