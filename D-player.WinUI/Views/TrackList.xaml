<UserControl
    x:Class="DPlayer.WinUI.Views.TrackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DPlayer.Models">

    <Grid>
        <!--
          ItemsSource 走代码后置赋值（ResyncView 里），不用 x:Bind：
          brief 给的 {x:Bind ViewModel.ViewedPlaylist.Queue, Mode=OneWay} 会让 XamlCompiler
          在 MarkupCompilePass1 里抛 WMC9999（可空中间段 ViewedPlaylist 是普通 INPC 属性，
          不是依赖属性，编译器内部崩溃且连错误消息都本地化失败）。见 Task 4 报告。
        -->
        <ListView x:Name="TrackItems" DoubleTapped="TrackList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Artist}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态：切片期没有导入入口（第二阶段接 picker），首启就是这个样子 -->
        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6" IsHitTestVisible="False">
            <TextBlock Text="当前歌单没有曲目" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="本切片不提供导入入口：把曲目写进 %LocalAppData%\D-player-winui\queue.json 后重启。"
                       HorizontalAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
