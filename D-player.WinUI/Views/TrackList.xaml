<UserControl
    x:Class="DPlayer.WinUI.Views.TrackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DPlayer.Models"
    xmlns:local="using:DPlayer.WinUI.Views">

    <UserControl.Resources>
        <local:NullableIntToDashConverter x:Key="NullableIntToDash" />
        <local:TimeSpanToMmSsConverter x:Key="TimeSpanToMmSs" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Task 3（Phase 22）：导入/导出工具栏（row 0，40px）。左组＝添加文件 / 导入文件夹 / 导入播放列表，
          中列是 16px 忙碌环（导入进行中才转），右组＝导出 M3U8 / 清空。
          五个钮的启用规则由代码后置的 UpdateToolbarState() 统一定：无歌单时左组全禁；
          队列空时「导出」「清空」禁用。图标钮几何走 ToolbarButtonSize（28），
          样式 IconButtonStyle 只给六态与视觉效果，不带固定尺寸。
        -->
        <Grid Grid.Row="0" Height="{StaticResource TrackToolbarHeight}"
              Padding="{StaticResource TrackListHeaderPadding}"
              ColumnSpacing="{StaticResource SpacingSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                <Button x:Name="AddFilesButton" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}"
                        Style="{StaticResource IconButtonStyle}" Click="AddFilesButton_Click"
                        AutomationProperties.Name="添加文件" ToolTipService.ToolTip="添加文件（多选）">
                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeCaption}" />
                </Button>
                <Button x:Name="ImportFolderButton" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}"
                        Style="{StaticResource IconButtonStyle}" Click="ImportFolderButton_Click"
                        AutomationProperties.Name="导入文件夹" ToolTipService.ToolTip="导入文件夹（递归扫描，追加到当前歌单）">
                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource FontSizeCaption}" />
                </Button>
                <Button x:Name="ImportListButton" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}"
                        Style="{StaticResource IconButtonStyle}" Click="ImportListButton_Click"
                        AutomationProperties.Name="导入播放列表" ToolTipService.ToolTip="导入播放列表（M3U / M3U8 / PLS，追加）">
                    <FontIcon Glyph="&#xE8E5;" FontSize="{StaticResource FontSizeCaption}" />
                </Button>
            </StackPanel>

            <ProgressRing x:Name="ImportProgress" Grid.Column="1" Width="16" Height="16"
                          IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                <Button x:Name="ExportButton" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}"
                        Style="{StaticResource IconButtonStyle}" Click="ExportButton_Click"
                        AutomationProperties.Name="导出播放列表" ToolTipService.ToolTip="导出为 M3U8">
                    <FontIcon Glyph="&#xE74E;" FontSize="{StaticResource FontSizeCaption}" />
                </Button>
                <Button x:Name="ClearButton" Width="{StaticResource ToolbarButtonSize}" Height="{StaticResource ToolbarButtonSize}"
                        Style="{StaticResource IconButtonStyle}" Click="ClearButton_Click"
                        AutomationProperties.Name="清空当前歌单" ToolTipService.ToolTip="清空当前歌单">
                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeCaption}" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
          静态表头（不可点击——表头不可点是有意的，排序属功能阶段，spec §5）。
          列宽与行模板同步：# 40 / 标题 * / 艺术家 220 / 时长 72（与表头同步）。
        -->
        <Grid x:Name="Header" Grid.Row="1" Height="{StaticResource RowHeight}"
              Padding="{StaticResource TrackListHeaderPadding}"
              ColumnSpacing="{StaticResource SpacingMd}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <!-- 与表头同步：# 40 / 标题 * / 艺术家 220 / 时长 72 -->
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="#" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="标题" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="艺术家" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="时长" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!--
          ItemsSource 走代码后置赋值（ResyncView 里），不用 x:Bind：
          brief 给的 {x:Bind ViewModel.ViewedPlaylist.Queue, Mode=OneWay} 会让 XamlCompiler
          在 MarkupCompilePass1 里抛 WMC9999（可空中间段 ViewedPlaylist 是普通 INPC 属性，
          不是依赖属性，编译器内部崩溃且连错误消息都本地化失败）。见 Phase 20 Task 4 报告。

          ItemContainerStyle 取 RailListViewItemStyle（六态容器：Normal/PointerOver/Pressed/Selected/
          PointerOverSelected/PressedSelected + Disabled），MinHeight=36（Tokens 的 RowHeight）。
          HorizontalContentAlignment=Stretch 已在基样式的 ContentPresenter 上 TemplateBinding
          （Task 3 修复），行内容可以撑满整行。
        -->
        <ListView x:Name="TrackItems" Grid.Row="2"
                  DoubleTapped="TrackList_DoubleTapped"
                  ContainerContentChanging="List_ContainerContentChanging"
                  ItemContainerStyle="{StaticResource RailListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <!-- 列宽与表头同步：# 40 / 标题 * / 艺术家 220 / 时长 72 -->
                    <Grid ColumnSpacing="{StaticResource SpacingMd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <!-- 序号：TrackNumber null 时显示 "-" -->
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind TrackNumber, Converter={StaticResource NullableIntToDash}}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- 标题：截断 -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- 艺术家：截断，次要色；null 时显示空（Artist 是 string?，x:Bind 对引用类型 null 不崩溃） -->
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Artist}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- 时长：mm:ss 等宽数字 -->
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind Duration, Converter={StaticResource TimeSpanToMmSs}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态：产品话术（spec §5），不承诺本阶段没有的能力 -->
        <!-- ⑨ 首次可见时淡入 150ms + 上移 8px -->
        <!-- 初始 Visibility 必须是 Collapsed：UpdateEmptyHint() 以"上一次是否 Visible"作为首播守卫，
             默认 Visible 会让启动即空歌单的场景跳过淡入、Opacity 停在 0（空态不可见）。 -->
        <StackPanel x:Name="EmptyHint" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{StaticResource SpacingSm}" IsHitTestVisible="False"
                    Visibility="Collapsed"
                    Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="EmptyHintTranslate" Y="8" />
            </StackPanel.RenderTransform>
            <TextBlock Text="还没有曲目" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="点击上方「添加文件」或「导入文件夹」开始" HorizontalAlignment="Center" MaxWidth="360"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
