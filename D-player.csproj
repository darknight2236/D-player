<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AssemblyName>D-player</AssemblyName>
        <RootNamespace>DPlayer</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <!--
      WPF SDK 在每次构建时生成临时辅助工程 *_wpftmp.csproj, 它会从本 csproj 所在目录
      重新 glob **/*.cs / *.xaml 等。Tests/ 是仓库根的兄弟目录(在本 csproj 同级),
      因此必须把 WPF/SDK 会 glob 的所有 item 类型显式排除, 防止测试源被双重编译进
      主程序集(否则会出现 AssemblyInfo 重复 + xunit 引用缺失)。如果以后把 Tests/
      移出仓库根, 这段可以删除。
    -->
    <ItemGroup>
        <Compile Remove="Tests/**" />
        <Page Remove="Tests/**" />
        <ApplicationDefinition Remove="Tests/**" />
        <Resource Remove="Tests/**" />
        <None Remove="Tests/**" />
        <EmbeddedResource Remove="Tests/**" />
    </ItemGroup>

    <!--
      D-player.Core/ 同样是仓库根的兄弟目录(在本 csproj 同级), 上面那段 glob 隐患对它
      一样成立: Core 的源与它自己的 obj/bin 生成物会被扫进 WPF 程序集重复编译。
      因此对 Core 目录做同样的一组显式排除(注意 D-player/Services/ 不在排除之列,
      Win32FileDialogService.cs 属于 WPF 壳, 必须继续被本工程编译)。
    -->
    <ItemGroup>
        <Compile Remove="D-player.Core/**" />
        <Page Remove="D-player.Core/**" />
        <ApplicationDefinition Remove="D-player.Core/**" />
        <Resource Remove="D-player.Core/**" />
        <None Remove="D-player.Core/**" />
        <EmbeddedResource Remove="D-player.Core/**" />
    </ItemGroup>

    <!--
      D-player.WinUI/ 是第三个仓库根的兄弟目录(同样在本 csproj 同级), 上面的 glob 隐患对它
      一样成立: 它的 .cs/.xaml 会被扫进 WPF 程序集, 而 WPF 侧并不存在 Microsoft.UI.Xaml,
      结果是 MC3074/CS0234 直接把门禁打挂。因此对它做同样的一组显式排除。WinUI 工程刻意
      不进 D-player.slnf(门禁只跑 Core + WPF + Tests), 这段排除是该隔离能成立的前提。
    -->
    <ItemGroup>
        <Compile Remove="D-player.WinUI/**" />
        <Page Remove="D-player.WinUI/**" />
        <ApplicationDefinition Remove="D-player.WinUI/**" />
        <Resource Remove="D-player.WinUI/**" />
        <None Remove="D-player.WinUI/**" />
        <EmbeddedResource Remove="D-player.WinUI/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="D-player.Core\D-player.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="D-player.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
