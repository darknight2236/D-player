<UserControl x:Class="DPlayer.Views.Controls.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DPlayer.Converters"
             xmlns:vm="clr-namespace:DPlayer.ViewModels;assembly=D-player.Core"
             xmlns:models="clr-namespace:DPlayer.Models;assembly=D-player.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             Background="{StaticResource BackgroundPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:BytesToBitmapImageConverter x:Key="BytesToBitmapImage"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToString"/>

        <!-- 库内主操作按钮：实心强调底 + 深色文字，避免与标题/副标题混淆 -->
        <Style x:Key="LibraryActionButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="{StaticResource BackgroundPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentPressed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 专辑 tile 的选中/悬停走深色模板，并让封面与文字在网格项内居中 -->
        <Style x:Key="AlbumTileItemStyle" TargetType="ListBoxItem">
            <!-- Margin 在项外形成项间距；Padding 在高亮框内给封面留顶部/侧边空隙 -->
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BackgroundTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行式列表沿用队列的外观：卡片底 + 行分隔 + 深色悬停/选中 -->
        <Style x:Key="LibraryRowItemStyle" TargetType="ListBoxItem">
            <!-- 与歌单队列行一致：队列行的删除按钮把内容高度撑到 20px，外加 8px 内边距 -->
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <Border Height="1"
                                    Background="{StaticResource BackgroundTertiary}"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BackgroundTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AlbumTileTemplate">
            <StackPanel Width="140"
                        HorizontalAlignment="Center"
                        Loaded="AlbumTile_Loaded">
                <Border Width="140" Height="140"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BackgroundTertiary}"
                        CornerRadius="6">
                    <Grid>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.MusicNote}"
                              Stroke="{StaticResource ForegroundSecondary}"
                              Width="36" Height="36"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <Image Source="{Binding CoverArt, Converter={StaticResource BytesToBitmapImage}}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource ForegroundPrimary}"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TrackRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <!-- ▶ 当前播放曲标记：由 LibraryView code-behind 刷新 -->
                <Path x:Name="PART_Marker"
                      Grid.Column="0"
                      Data="{StaticResource Icon.PlayMarker}"
                      Fill="{StaticResource AccentPrimary}"
                      Width="9" Height="9" Stretch="Uniform"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TrackNumber}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Title}"
                           Foreground="{StaticResource ForegroundPrimary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding Duration, Converter={StaticResource TimeSpanToString}}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryArtist}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource ForegroundPrimary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Summary}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryAlbum}">
            <Grid Loaded="SearchAlbum_Loaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36"
                        Background="{StaticResource BackgroundTertiary}"
                        CornerRadius="4"
                        HorizontalAlignment="Left">
                    <Grid>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.MusicNote}"
                              Stroke="{StaticResource ForegroundSecondary}"
                              Width="16" Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <Image Source="{Binding CoverArt, Converter={StaticResource BytesToBitmapImage}}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{StaticResource ForegroundPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{StaticResource ForegroundSecondary}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Track}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="PART_Marker"
                      Grid.Column="0"
                      Data="{StaticResource Icon.PlayMarker}"
                      Fill="{StaticResource ForegroundPrimary}"
                      Width="9" Height="9" Stretch="Uniform"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{StaticResource ForegroundPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{StaticResource ForegroundSecondary}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Artist, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding Album, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding Duration, Converter={StaticResource TimeSpanToString}}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="返回"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                            Click="Back_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M10,0 L2,8 L10,16"
                              Stroke="{StaticResource ForegroundPrimary}"
                              Width="12" Height="12"/>
                    </Button>
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="8,0,40,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding CanGoBack, Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="刷新音乐库"
                        Click="Refresh_Click">
                    <Path Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.Refresh}"
                          Stroke="{StaticResource ForegroundPrimary}"
                          Width="14" Height="14"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource BackgroundSecondary}"
                        CornerRadius="4">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MinHeight="30"
                                 Foreground="{StaticResource ForegroundPrimary}"
                                 CaretBrush="{StaticResource ForegroundPrimary}"
                                 Padding="8,5"
                                 Text="{Binding SearchQuery, Mode=OneWay}"
                                 AutomationProperties.Name="搜索艺术家、专辑或曲目"
                                 ToolTip="搜索艺术家、专辑或曲目"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <TextBlock Text="搜索艺术家、专辑或曲目"
                                   Foreground="{StaticResource ForegroundSecondary}"
                                   Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                     Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="清空" Margin="6,0,0,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="ClearSearch_Click" AutomationProperties.Name="清空搜索"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Border Background="{StaticResource BackgroundSecondary}"
                    CornerRadius="4"
                    Visibility="{Binding IsArtistsPage, Converter={StaticResource BoolToVisibility}}">
                <ListBox x:Name="ArtistsList"
                         ItemsSource="{Binding Artists}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource LibraryRowItemStyle}"
                         MouseDoubleClick="ArtistsList_MouseDoubleClick"
                         KeyDown="ArtistsList_KeyDown"
                         PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource ForegroundPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="{StaticResource ForegroundSecondary}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ListBox ItemsSource="{Binding Albums}"
                     ItemTemplate="{StaticResource AlbumTileTemplate}"
                     ItemContainerStyle="{StaticResource AlbumTileItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsAlbumsPage, Converter={StaticResource BoolToVisibility}}"
                     MouseDoubleClick="AlbumsList_MouseDoubleClick"
                     KeyDown="AlbumsList_KeyDown"
                     PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Grid Visibility="{Binding IsArtistDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedArtist.Name}"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedArtist.Summary}"
                                   Foreground="{StaticResource ForegroundSecondary}"
                                   Margin="12,0,0,0"/>
                    </Grid>
                    <Button Content="播放全部"
                            Style="{StaticResource LibraryActionButton}"
                            Command="{Binding PlayArtistCommand}"
                            CommandParameter="{Binding SelectedArtist}"/>
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SelectedArtist.Albums}"
                         ItemTemplate="{StaticResource AlbumTileTemplate}"
                         ItemContainerStyle="{StaticResource AlbumTileItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ArtistAlbumsList_MouseDoubleClick"
                         KeyDown="ArtistAlbumsList_KeyDown"
                         PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <Grid Visibility="{Binding IsAlbumDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="120"
                            Background="{StaticResource BackgroundTertiary}"
                            CornerRadius="6"
                            Loaded="AlbumDetailCover_Loaded">
                        <Grid>
                            <Path Style="{StaticResource IconPath}"
                                  Data="{StaticResource Icon.MusicNote}"
                                  Stroke="{StaticResource ForegroundSecondary}"
                                  Width="36" Height="36"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <Image Source="{Binding SelectedAlbum.CoverArt, Converter={StaticResource BytesToBitmapImage}}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SelectedAlbum.Title}"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedAlbum.Subtitle}"
                                   Foreground="{StaticResource ForegroundSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="播放全部"
                                Style="{StaticResource LibraryActionButton}"
                                Command="{Binding PlayAlbumCommand}"
                                CommandParameter="{Binding SelectedAlbum}"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1"
                        Background="{StaticResource BackgroundSecondary}"
                        CornerRadius="4">
                    <ListBox x:Name="AlbumTracksList"
                             ItemsSource="{Binding SelectedAlbum.Tracks}"
                             ItemTemplate="{StaticResource TrackRowTemplate}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource LibraryRowItemStyle}"
                             MouseDoubleClick="AlbumTracksList_MouseDoubleClick"
                             KeyDown="AlbumTracksList_KeyDown"
                             PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown"/>
                </Border>
            </Grid>

            <ListBox x:Name="SearchResultsList"
                     ItemsSource="{Binding SearchRowsView, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     BorderThickness="0"
                     Background="{StaticResource BackgroundSecondary}"
                     Visibility="{Binding IsSearchPage, Converter={StaticResource BoolToVisibility}}"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ItemContainerStyle="{StaticResource LibraryRowItemStyle}"
                     PreviewMouseLeftButtonUp="SearchResults_MouseLeftButtonUp"
                     MouseDoubleClick="SearchResults_MouseDoubleClick"
                     KeyDown="SearchResults_KeyDown"
                     PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource ForegroundSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="8,8,0,4">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Item}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding SearchMessage}"
                       Foreground="{StaticResource ForegroundSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="16"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsSearchPage, Converter={StaticResource BoolToVisibility}}"/>

            <Border Background="{StaticResource BackgroundPrimary}"
                    Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyStateText}"
                               Foreground="{StaticResource ForegroundPrimary}"
                               FontSize="15"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在设置中添加一个或多个音乐文件夹"
                               Foreground="{StaticResource ForegroundSecondary}"
                               Margin="0,6,0,12"
                               HorizontalAlignment="Center"/>
                    <Button Content="打开设置"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Click="OpenSettings_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource ForegroundSecondary}"
                   FontSize="11"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>
