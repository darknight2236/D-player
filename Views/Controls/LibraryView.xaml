<UserControl x:Class="DPlayer.Views.Controls.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DPlayer.Converters"
             xmlns:vm="clr-namespace:DPlayer.ViewModels;assembly=D-player.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             Background="{StaticResource BackgroundPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BytesToBitmapImageConverter x:Key="BytesToBitmapImage"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToString"/>

        <!-- 显式 Style 会替换隐式 Button 样式，必须 BasedOn 才能保留深色模板（否则回落 Aero 灰） -->
        <Style x:Key="LibraryActionButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 专辑 tile 的选中/悬停走深色模板，并让封面与文字在网格项内居中 -->
        <Style x:Key="AlbumTileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BackgroundTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AlbumTileTemplate">
            <StackPanel Width="140" Margin="6,0,6,12"
                        HorizontalAlignment="Center"
                        Loaded="AlbumTile_Loaded">
                <Border Width="140" Height="140"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BackgroundTertiary}"
                        CornerRadius="6">
                    <Grid>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.MusicNote}"
                              Stroke="{StaticResource ForegroundSecondary}"
                              Width="36" Height="36"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <Image Source="{Binding CoverArt, Converter={StaticResource BytesToBitmapImage}}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource ForegroundPrimary}"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TrackRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TrackNumber}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           Foreground="{StaticResource ForegroundPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Duration, Converter={StaticResource TimeSpanToString}}"
                           Foreground="{StaticResource ForegroundSecondary}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="返回"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                        Click="Back_Click">
                    <Path Style="{StaticResource IconPath}"
                          Data="M10,0 L2,8 L10,16"
                          Stroke="{StaticResource ForegroundPrimary}"
                          Width="12" Height="12"/>
                </Button>
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="8,0,40,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    ToolTip="刷新音乐库"
                    Click="Refresh_Click">
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource Icon.Refresh}"
                      Stroke="{StaticResource ForegroundPrimary}"
                      Width="14" Height="14"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="ArtistsList"
                     ItemsSource="{Binding Artists}"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="{Binding IsArtistsPage, Converter={StaticResource BoolToVisibility}}"
                     MouseDoubleClick="ArtistsList_MouseDoubleClick"
                     KeyDown="ArtistsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource ForegroundPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Summary}"
                                       Foreground="{StaticResource ForegroundSecondary}"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox ItemsSource="{Binding Albums}"
                     ItemTemplate="{StaticResource AlbumTileTemplate}"
                     ItemContainerStyle="{StaticResource AlbumTileItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsAlbumsPage, Converter={StaticResource BoolToVisibility}}"
                     MouseDoubleClick="AlbumsList_MouseDoubleClick"
                     KeyDown="AlbumsList_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Grid Visibility="{Binding IsArtistDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedArtist.Name}"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedArtist.Summary}"
                                   Foreground="{StaticResource ForegroundSecondary}"
                                   Margin="12,0,0,0"/>
                    </Grid>
                    <Button Content="播放全部"
                            Style="{StaticResource LibraryActionButton}"
                            Command="{Binding PlayArtistCommand}"
                            CommandParameter="{Binding SelectedArtist}"/>
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SelectedArtist.Albums}"
                         ItemTemplate="{StaticResource AlbumTileTemplate}"
                         ItemContainerStyle="{StaticResource AlbumTileItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ArtistAlbumsList_MouseDoubleClick"
                         KeyDown="ArtistAlbumsList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <Grid Visibility="{Binding IsAlbumDetailPage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="120"
                            Background="{StaticResource BackgroundTertiary}"
                            CornerRadius="6"
                            Loaded="AlbumDetailCover_Loaded">
                        <Grid>
                            <Path Style="{StaticResource IconPath}"
                                  Data="{StaticResource Icon.MusicNote}"
                                  Stroke="{StaticResource ForegroundSecondary}"
                                  Width="36" Height="36"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <Image Source="{Binding SelectedAlbum.CoverArt, Converter={StaticResource BytesToBitmapImage}}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SelectedAlbum.Title}"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedAlbum.Subtitle}"
                                   Foreground="{StaticResource ForegroundSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="播放全部"
                                Style="{StaticResource LibraryActionButton}"
                                Command="{Binding PlayAlbumCommand}"
                                CommandParameter="{Binding SelectedAlbum}"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="AlbumTracksList"
                         Grid.Row="1"
                         ItemsSource="{Binding SelectedAlbum.Tracks}"
                         ItemTemplate="{StaticResource TrackRowTemplate}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="AlbumTracksList_MouseDoubleClick"
                         KeyDown="AlbumTracksList_KeyDown"/>
            </Grid>

            <Border Background="{StaticResource BackgroundPrimary}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyStateText}"
                               Foreground="{StaticResource ForegroundPrimary}"
                               FontSize="15"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在设置中添加一个或多个音乐文件夹"
                               Foreground="{StaticResource ForegroundSecondary}"
                               Margin="0,6,0,12"
                               HorizontalAlignment="Center"/>
                    <Button Content="打开设置"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Click="OpenSettings_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource ForegroundSecondary}"
                   FontSize="11"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>
